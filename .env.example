LLM_PROVIDER=mock

# Para usar a faixa gratuita da API Groq, crie uma chave em
# https://console.groq.com/keys e configure:
# LLM_PROVIDER=groq
# GROQ_API_KEY=cole_sua_chave_aqui
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Outros provedores compativeis com Chat Completions tambem podem usar:
# LLM_PROVIDER=http
# LLM_API_BASE_URL=https://api.exemplo.com/v1/chat/completions
# LLM_API_KEY=sua-chave-aqui
# LLM_MODEL=modelo-exemplo
